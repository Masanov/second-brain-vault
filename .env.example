# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any model that supports tool calling.
OPENROUTER_MODEL=qwen/qwen3.7-plus

# Optional. Safety cap on the tool-use loop.
MAX_ITERATIONS=25

# Optional, for local runs only:
#   DRY_RUN=1    run the model, write files, touch git not at all
#   SKIP_PUSH=1  commit locally but do not push
